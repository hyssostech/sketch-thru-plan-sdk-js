    "target": "ES2017",
    "module": "ES2015",
    "moduleResolution": "node",
    "strict": false,
    "declaration": true,
    "outDir": "build",
    "skipLibCheck": true,
    "sourceMap": true,
    "inlineSources": true,
    "inlineSourceMap": false
  },
  "include": ["src/**/*.ts"]
}
