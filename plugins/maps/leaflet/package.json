{
  "name": "@hyssostech/leaflet-plugin",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyssostech/sketch-thru-plan-sdk-js.git",
    "directory": "plugins/maps/leaflet"
  },
  "private": false,
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "rimraf dist build",
    "clean:docs": "rimraf docs",
    "build": "npm run clean && tsc --project tsconfig.json && npm run bundle",
    "bundle": "npm run bundle:umd && npm run bundle:esm && npm run bundle:dts && npm run bundle:min",
    "bundle:umd": "rollup build/leaflet.js --file dist/leaflet-bundle.js --format umd --name LeafletMap",
    "bundle:esm": "rollup build/leaflet.js --file dist/leaflet-bundle.esm.js --format esm",
    "bundle:dts": "rollup build/leaflet.d.ts --file dist/leaflet-bundle.d.ts --format es --plugin rollup-plugin-dts",
    "bundle:min": "terser --ecma 6 --compress --mangle --module -o dist/leaflet-bundle-min.js -- dist/leaflet-bundle.js",
    "fix:format": "prettier --config ../../.prettierrc src --write",
    "build:docs": "npm run clean:docs && typedoc --tsconfig tsconfig.json",
    "build:dev": "npm run clean && tsc --project tsconfig.json && npm run bundle:dev",
    "bundle:dev": "npm run bundle:umd:dev && npm run bundle:dts",
    "bundle:umd:dev": "rollup build/leaflet.js --file dist/leaflet-bundle-min.js --format umd --name LeafletMap",
    "prepublishOnly": "npm run build",
    "publish:dry": "npm run build && npm pack"
  },
  "peerDependencies": {
    "sketch-thru-plan-sdk": "^0.6.15"
  },
  "devDependencies": {
    "sketch-thru-plan-sdk": "file:../../.."
  }
}
