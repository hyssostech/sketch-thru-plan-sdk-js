{
  "name": "milsymts-renderer",
  "version": "0.1.0",
  "private": true,
  "description": "Side-by-side renderer using mil-sym-ts WebRenderer",
  "type": "module",
  "scripts": {
    "clean": "rimraf build dist",
    "build:ts": "tsc -p tsconfig.json",
    "build:umd": "rollup -c",
    "build": "npm run clean && npm run build:ts && npm run build:umd"
  },
  "peerDependencies": {
    "sketch-thru-plan-sdk": "^0.6.15"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "sketch-thru-plan-sdk": "file:../../.."
  },
  "dependencies": {
    "@armyc2.c5isr.renderer/mil-sym-ts-web": "2.10.4"
  }
}
