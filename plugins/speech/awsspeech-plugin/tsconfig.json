{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
      "target": "es2020", 
      "module": "es2020",
        "outDir": "build",
        "experimentalDecorators": true,
        "skipLibCheck": true
    },
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "node_modules",
      "dist",
      "build",
      "test"
    ],
    "typedocOptions": {  
      "entryPoints": [
        "./src/stpawsspeech.ts"
      ],
      "readme": "README.md",
      "out": "docs",
      "excludePrivate": "true",
      "theme": "default",
      "includeVersion": "true", 
      "name": "Sketch-thru-Plan AWS Speech Connector"
    }
}
  
