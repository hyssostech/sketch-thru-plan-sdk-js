{
  "$schema": "./sketch-thru-plan-validations.schema.json",
  "title": "Sketch-thru-Plan call validations",
  "description": "Data-driven checks a client runs around a state-changing STP call (STP-1064): before the call, the preconditions, the params the engine silently ignores a call without, and the poids that must name existing objects; after the call, the events that prove it did what it asked (intent). Every write and destructive method of the contract has an entry. See README.md, 'Call validations'.",
  "version": "1.0.5",
  "contractVersion": "0.9.6",
  "refusalMessage": {
    "event": "StpMessage",
    "contains": "'{method}'"
  },
