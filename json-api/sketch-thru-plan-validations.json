    "ImportCoaFromObjectSet": {
      "preconditions": [
        "activeScenario"
      ],
      "required": [
        "objects"
      ],
      "intent": {
        "expect": [
          {
            "forEach": "objects",
            "where": {
              "fsTYPE": {
                "in": [
                  "coa"
                ]
              }
            },
            "anyOf": [
              {
                "event": "CoaAdded",
                "match": {
                  "poid": {
                    "item": "poid"
                  }
                }
              },
              {
                "event": "CoaDeleted",
                "match": {
                  "poid": {
                    "item": "poid"
                  }
                }
              }
            ]
          },
          {
            "forEach": "objects",
            "where": {
              "fsTYPE": {
                "notIn": [
                  "coa",
                  "task",
                  "task_org",
                  "task_org_unit",
                  "task_org_relationship",
                  "planning_scenario",
                  "system_state"
                ]
              }
            },
            "anyOf": [
              {
                "event": "SymbolAdded",
                "match": {
                  "alternates.0.poid": {
                    "item": "poid"
                  }
                }
              },
              {
                "event": "SymbolDeleted",
                "match": {
                  "poid": {
                    "item": "poid"
                  }
                }
              }
            ]
          },
          {
            "forEach": "objects",
            "where": {
              "fsTYPE": {
                "in": [
                  "task"
                ]
              }
            },
            "anyOf": [
              {
                "event": "TaskAdded",
                "match": {
                  "poid": {
                    "item": "poid"
                  }
                }
              },
              {
                "event": "TaskDeleted",
                "match": {
                  "poid": {
                    "item": "poid"
                  }
                }
              }
            ]
          }
        ]
      },
      "confirm": "Imports the {objects.length} objects given; an imported object REPLACES a resident one with the same poid."
    },
